#!/bin/bash
# laptop-control-center root yardımcısı. pkexec ile çağrılır; polkit kuralı etkin
# oturumdaki kullanıcıya parolasız izin verir. Yalnızca aşağıdaki dar işleri yapar:
#   aspm <default|performance|powersave|powersupersave>
#                                    (tasarrufta kablosuz ethernet kartının L1'i de açılır)
#   wifi-powersave <on|off>
#   service <stop|start> <birim>     (yalnızca ALLOWED listesindekiler)
#   cpus <liste|all>                 (çağıran kullanıcının oturum dilimi)
#   rfkill bluetooth <block|unblock>
#   camera <on|off>                  (USB görüntü sınıfı arayüzleri uvcvideo'ya bağlanır/ayrılır)
#   tcc-profiles <profiles.json> <settings.json>   (tccd profillerini yeniden yazar)
#   turbo <on|off>                   (işlemci turbo; açıkken her açılışta da açılır)
#   net-tune <on|off>                (TCP BBR + fq, büyük arabellekler, MTU yoklaması)
#   dns <auto|google|cloudflare|quad9|adguard|opendns|controld>
#                                    (sistem DNS'i; auto = ağın/modemin DNS'i)
#   trim <on|off>                    (haftalık SSD TRIM zamanlayıcısı)
#   sleep <on|off>                   (off: kapak ve uyku tuşu sistemi uyutmaz; ekran kapanır,
#                                     işlemler sürer)
#   gpu <saat MHz|reset> <güç W>      (NVIDIA saat tavanı ve güç sınırı; alt saat en düşükte)
#   version
set -euo pipefail
export PATH=/usr/sbin:/usr/bin

VERSION=6
TCCD=/opt/tuxedo-control-center/resources/dist/tuxedo-control-center/data/service/tccd
ALLOWED=(nvidia-powerd avahi-daemon cups ollama)

die() { echo "lcc-helper: $*" >&2; exit 2; }

case "${1:-}" in
  version)
    echo "$VERSION" ;;
  aspm)
    [[ ${2:-} =~ ^(default|performance|powersave|powersupersave)$ ]] || die "geçersiz ASPM politikası"
    echo "$2" > /sys/module/pcie_aspm/parameters/policy
    # r8169 gibi sürücüler ASPM'i kendileri kapatır; kablo takılı değilken kart boşa
    # PCIe bağlantısını açık tutup işlemcinin derin uykuya inmesini engeller.
    for net in /sys/class/net/*; do
      dev=$(readlink -f "$net/device" 2>/dev/null) || continue
      [[ $(cat "$dev/class" 2>/dev/null) == 0x0200* && -e $dev/link/l1_aspm ]] || continue
      if [[ $2 == power*save && $(cat "$net/carrier" 2>/dev/null || echo 0) != 1 ]]; then
        echo 1 > "$dev/link/l1_aspm" || true
        echo auto > "$dev/power/control"
      elif [[ $2 != power*save ]]; then
        echo 0 > "$dev/link/l1_aspm" || true
        echo on > "$dev/power/control"
      fi
    done ;;
  wifi-powersave)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    for dev in $(iw dev | awk '$1 == "Interface" {print $2}'); do
      iw dev "$dev" set power_save "$2"
    done ;;
  service)
    [[ ${2:-} =~ ^(stop|start)$ ]] || die "stop|start bekleniyor"
    unit=${3:-}
    ok=0
    for a in "${ALLOWED[@]}"; do [[ $unit == "$a" ]] && ok=1; done
    (( ok )) || die "izin verilmeyen birim: $unit"
    # Kurulu olmayan servis (ör. ollama) sessizce atlanır.
    systemctl cat "$unit.service" >/dev/null 2>&1 || exit 0
    # Soket etkinleştirmesi servisi hemen geri getirmesin diye soketi de durdur.
    sockets=()
    systemctl cat "$unit.socket" >/dev/null 2>&1 && sockets=("$unit.socket")
    if [[ $2 == stop ]]; then
      systemctl stop "${sockets[@]}" "$unit.service"
    else
      systemctl start "${sockets[@]}" "$unit.service"
    fi ;;
  cpus)
    uid=${PKEXEC_UID:-}
    [[ $uid =~ ^[0-9]+$ ]] || die "pkexec ile çağrılmalı"
    if [[ ${2:-} == all ]]; then
      systemctl set-property --runtime "user-$uid.slice" AllowedCPUs=
    else
      [[ ${2:-} =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || die "geçersiz çekirdek listesi"
      systemctl set-property --runtime "user-$uid.slice" "AllowedCPUs=$2"
    fi ;;
  rfkill)
    [[ ${2:-} == bluetooth && ${3:-} =~ ^(block|unblock)$ ]] || die "rfkill bluetooth block|unblock bekleniyor"
    rfkill "$3" bluetooth ;;
  camera)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    [[ $2 == on ]] && modprobe uvcvideo
    for intf in /sys/bus/usb/devices/*:*; do
      [[ $(cat "$intf/bInterfaceClass" 2>/dev/null) == 0e ]] || continue
      name=$(basename "$intf")
      drv=""
      [[ -e $intf/driver ]] && drv=$(basename "$(readlink -f "$intf/driver")")
      if [[ $2 == off && $drv == uvcvideo ]]; then
        echo "$name" > /sys/bus/usb/drivers/uvcvideo/unbind
      elif [[ $2 == on && -z $drv ]]; then
        # Kontrol arayüzü bağlanınca akış arayüzünü sürücü kendisi alır; o zaman bu hata verir.
        echo "$name" > /sys/bus/usb/drivers/uvcvideo/bind 2>/dev/null || true
      fi
    done ;;
  tcc-profiles)
    [[ -x $TCCD ]] || die "tccd bulunamadı"
    src_p=${2:-}; src_s=${3:-}
    for f in "$src_p" "$src_s"; do
      [[ -f $f && ! -L $f ]] || die "dosya yok: $f"
    done
    # Çağıranın değiştiremeyeceği kopyalar üzerinden çalış.
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    install -m644 "$src_p" "$tmp/profiles.json"
    install -m644 "$src_s" "$tmp/settings.json"
    python3 -c 'import json,sys; [json.load(open(f)) for f in sys.argv[1:]]' "$tmp/profiles.json" "$tmp/settings.json" \
      || die "geçersiz JSON"
    "$TCCD" --new_profiles "$tmp/profiles.json" --new_settings "$tmp/settings.json" ;;
  turbo)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    # Bazı Clevo/Monster BIOS'ları açılışta turbo'yu kapatıyor; tmpfiles her açılışta düzeltir.
    rm -f /etc/tmpfiles.d/cpu-turbo.conf
    if [[ -e /sys/devices/system/cpu/intel_pstate/no_turbo ]]; then
      file=/sys/devices/system/cpu/intel_pstate/no_turbo on=0 off=1
    elif [[ -e /sys/devices/system/cpu/cpufreq/boost ]]; then
      file=/sys/devices/system/cpu/cpufreq/boost on=1 off=0
    else
      die "turbo denetimi yok"
    fi
    if [[ $2 == on ]]; then
      echo "$on" > "$file"
      echo "w $file - - - - $on" > /etc/tmpfiles.d/lcc-turbo.conf
    else
      echo "$off" > "$file"
      rm -f /etc/tmpfiles.d/lcc-turbo.conf
    fi ;;
  net-tune)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    rm -f /etc/sysctl.d/99-ag-performans.conf /etc/modules-load.d/bbr.conf
    if [[ $2 == on ]]; then
      cat > /etc/sysctl.d/90-lcc-net.conf <<'EOF'
# laptop-control-center: internet hızı ayarları. Kapatmak için Kontrol Merkezi > Optimizasyon.
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 131072 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_fastopen = 3
EOF
      echo tcp_bbr > /etc/modules-load.d/lcc-bbr.conf
      modprobe tcp_bbr
      sysctl -q -p /etc/sysctl.d/90-lcc-net.conf
    else
      rm -f /etc/sysctl.d/90-lcc-net.conf /etc/modules-load.d/lcc-bbr.conf
      sysctl -q -w net.core.default_qdisc=fq_codel net.ipv4.tcp_congestion_control=cubic \
        net.core.rmem_max=212992 net.core.wmem_max=212992 \
        "net.ipv4.tcp_rmem=4096 131072 6291456" "net.ipv4.tcp_wmem=4096 16384 4194304" \
        net.ipv4.tcp_mtu_probing=0 net.ipv4.tcp_slow_start_after_idle=1 net.ipv4.tcp_fastopen=1
      sysctl -q --system || true
    fi ;;
  dns)
    case ${2:-} in
      google)     servers="8.8.8.8#dns.google 8.8.4.4#dns.google" ;;
      cloudflare) servers="1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com" ;;
      quad9)      servers="9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net" ;;
      adguard)    servers="94.140.14.140#unfiltered.adguard-dns.com 94.140.14.141#unfiltered.adguard-dns.com" ;;
      opendns)    servers="208.67.222.222 208.67.220.220" ;;
      controld)   servers="76.76.2.0#p0.freedns.controld.com 76.76.10.0#p0.freedns.controld.com" ;;
      auto)       servers="" ;;
      *) die "bilinmeyen DNS sağlayıcısı" ;;
    esac
    rm -f /etc/systemd/resolved.conf.d/30-dns.conf /etc/NetworkManager/conf.d/50-dns.conf
    if [[ -n $servers ]]; then
      mkdir -p /etc/systemd/resolved.conf.d
      printf '%s\n' "# laptop-control-center: sistem DNS'i ($2). Kontrol Merkezi > Optimizasyon'dan değiştirilir." \
        "[Resolve]" "DNS=$servers" "Domains=~." > /etc/systemd/resolved.conf.d/30-lcc-dns.conf
    else
      rm -f /etc/systemd/resolved.conf.d/30-lcc-dns.conf
    fi
    systemctl restart systemd-resolved ;;
  trim)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    if [[ $2 == on ]]; then systemctl enable --now fstrim.timer; else systemctl disable --now fstrim.timer; fi ;;
  sleep)
    [[ ${2:-} =~ ^(on|off)$ ]] || die "on|off bekleniyor"
    conf=/etc/systemd/logind.conf.d/30-lcc-no-sleep.conf
    if [[ $2 == off ]]; then
      mkdir -p /etc/systemd/logind.conf.d
      printf '%s\n' "# laptop-control-center: sistem kendiliğinden uyumaz; kapak kapanınca yalnızca ekran kapanır." \
        "# Geri almak için Kontrol Merkezi > Optimizasyon." "[Login]" \
        "HandleLidSwitch=ignore" "HandleLidSwitchExternalPower=ignore" "HandleLidSwitchDocked=ignore" \
        "HandleSuspendKey=ignore" "HandleHibernateKey=ignore" "IdleAction=ignore" > "$conf"
    else
      rm -f "$conf"
    fi
    # logind yeniden başlatılırsa oturum kapanır; yalnızca ayarları yeniden okut.
    systemctl reload systemd-logind ;;
  gpu)
    [[ ${2:-} =~ ^([0-9]{3,4}|reset)$ && ${3:-} =~ ^[0-9]{1,3}$ ]] || die "gpu <MHz|reset> <W> bekleniyor"
    command -v nvidia-smi >/dev/null || die "nvidia-smi yok"
    if [[ $2 == reset ]]; then
      nvidia-smi -rgc >/dev/null
    else
      min=$(nvidia-smi --query-supported-clocks=gr --format=csv,noheader,nounits | sort -n | head -1)
      nvidia-smi -lgc "${min:-0},$2" >/dev/null
    fi
    nvidia-smi -pl "$3" >/dev/null ;;
  *)
    die "bilinmeyen komut: ${1:-}" ;;
esac
